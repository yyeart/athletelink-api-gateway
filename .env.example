GATEWAY_HTTP_ADDR=:8080
GATEWAY_CORE_URL=http://localhost:8081
REDIS_ADDR=localhost:6379
# REDIS_PASSWORD must match the password configured for the shared Redis.
# JWT_SECRET must match Auth's UTF-8 secret (at least 64 bytes for HS512).
# REDIS_PASSWORD=replace-me
# JWT_SECRET=replace-me
GATEWAY_READ_HEADER_TIMEOUT=5s
GATEWAY_READ_TIMEOUT=15s
GATEWAY_WRITE_TIMEOUT=15s
GATEWAY_IDLE_TIMEOUT=60s
GATEWAY_SHUTDOWN_TIMEOUT=10s
GATEWAY_LOG_LEVEL=info
