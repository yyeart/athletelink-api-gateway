GATEWAY_HTTP_ADDR=:8080
GATEWAY_CORE_URL=http://localhost:8081
# Required: set Auth and Game origins without /api/v1 or another base path.
# GATEWAY_AUTH_URL=http://<auth-host>:<port>
# GATEWAY_GAME_URL=http://<game-host>:<port>
# Required: set the actual full health endpoint URL for each service.
# GATEWAY_CORE_HEALTH_URL=http://<core-host>:<port>/<health-path>
# GATEWAY_AUTH_HEALTH_URL=http://<auth-host>:<port>/<health-path>
# GATEWAY_GAME_HEALTH_URL=http://<game-host>:<port>/<health-path>
GATEWAY_CORE_TIMEOUT=10s
GATEWAY_AUTH_TIMEOUT=10s
GATEWAY_GAME_TIMEOUT=10s
GATEWAY_HEALTH_TIMEOUT=2s
REDIS_ADDR=localhost:6379
# REDIS_PASSWORD must match the password configured for the shared Redis.
# JWT_SECRET must match Auth's UTF-8 secret (at least 64 bytes for HS512).
# REDIS_PASSWORD=replace-me
# JWT_SECRET=replace-me
GATEWAY_READ_HEADER_TIMEOUT=5s
GATEWAY_READ_TIMEOUT=15s
GATEWAY_WRITE_TIMEOUT=15s
GATEWAY_IDLE_TIMEOUT=60s
GATEWAY_SHUTDOWN_TIMEOUT=10s
GATEWAY_LOG_LEVEL=info
